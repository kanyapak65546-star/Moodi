        <h3>Love Mood</h3>
        <p>
          เติมความหวานให้หัวใจ
          ด้วยคุกกี้ที่เต็มไปด้วยความรัก
        </p>
      </div>

      <div class="mood-card energy">
        <div class="mood-icon">⚡</div>
        <h3>Energy Mood</h3>
        <p>
          วันที่ต้องการพลัง
          เติมความอร่อยให้พร้อมลุย
        </p>
      </div>

    </div>

  </section>


  <!-- PRODUCTS -->
  <section class="products" id="products">

    <h2 class="section-title">
