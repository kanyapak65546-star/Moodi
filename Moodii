      ของตัวเองในแต่ละวัน
    </p>

    <a href="#products" class="btn">
      Discover Your Mood 🍪
    </a>

  </section>


  <!-- FOOTER -->
  <footer>

    <h2>Moodi.</h2>

    <p>
      Cookies for every mood.
    </p>

    <p>
      © 2026 Moodi Cookie. All Rights Reserved.
    </p>

  </footer>

</body>
</html>
